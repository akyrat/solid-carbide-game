# Copy this file to .env (git-ignored) and fill in the values.
# What each variable is for: README.md, section "Secrets and API keys".

# Full path to the Godot 4.6.2 console executable, e.g. C:/Tools/Godot/Godot_vX.Y-stable_win64_console.exe
GODOT_BIN=

# Freesound API credentials (SFX Agent)
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
FREESOUND_REDIRECT_URI=

# PixelLab API key (Asset Generation Agent)
PIXELLAB_API_KEY=
